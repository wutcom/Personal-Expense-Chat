# Public project URL and publishable key from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical application origin for confirmation/recovery emails; HTTPS in production.
SITE_URL=http://localhost:3000
# Never put service-role/secret keys in this app or NEXT_PUBLIC_* variables.

# Google Sheets ledger (server-only). See docs/google-sheets-setup.md.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_OWNER_ID=
