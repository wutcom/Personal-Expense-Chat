# Public project URL and publishable key from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical application origin for confirmation/recovery emails; HTTPS in production.
SITE_URL=http://localhost:3000
# Never put service-role/secret keys in this app or NEXT_PUBLIC_* variables.
