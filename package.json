{
  "name": "personal-expense-chat",
  "version": "0.1.0",
  "description": "Thai-first personal expense chat — Phase 1 scaffold",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
